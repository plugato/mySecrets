# Exemplo de configuração de ambiente
# Copie este arquivo para .env e configure as opções necessárias

# Configurações da aplicação
APP_NAME=MySecrets
APP_VERSION=1.0.0

# Configurações de segurança
ENCRYPTION_ALGORITHM=aes-256-gcm
HASH_ROUNDS=12

# Configurações de desenvolvimento (opcional)
NODE_ENV=development
DEBUG_MODE=false

# Configurações de MFA
TOTP_WINDOW=1
TOTP_STEP=30