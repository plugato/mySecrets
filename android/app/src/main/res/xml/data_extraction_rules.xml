<?xml version="1.0" encoding="utf-8"?>
<!-- Nada vai para o backup do Google nem para transferência entre aparelhos:
     as chaves do Keystore não viajam e o cofre já sincroniza pelo Drive. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
