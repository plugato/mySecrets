{
  "name": "mysecrets",
  "version": "2.1.1",
  "description": "Secure password and MFA manager built with Electron",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/**/*.e2e.js\"",
    "lint": "eslint .",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "electron",
    "password-manager",
    "mfa",
    "totp",
    "security"
  ],
  "author": "Plugato",
  "license": "MIT",
  "homepage": "https://github.com/plugato/mySecrets",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "axe-core": "^4.14.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.14.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "tldts": "^7.4.19"
  },
  "build": {
    "appId": "com.mysecrets.app",
    "productName": "MySecrets",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "plugato",
      "repo": "mySecrets",
      "releaseType": "release"
    },
    "files": [
      "src/**/*",
      "mcp-server/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "mcp-server/**/*",
      "src/lib/vault-crypto.js",
      "src/lib/session-crypto.js",
      "src/lib/otp.js",
      "node_modules/otplib/**/*",
      "node_modules/@otplib/**/*",
      "node_modules/thirty-two/**/*",
      "node_modules/tldts/**/*",
      "node_modules/tldts-core/**/*"
    ],
    "electronFuses": {
      "runAsNode": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "mac": {
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "maintainer": "Plugato"
    }
  }
}
